      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PC9F690ACD2F736A4"
          },
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  time,\n  node_name,\n  CASE\n    WHEN network_rx_bytes_total < LAG(network_rx_bytes_total) OVER w THEN NULL\n    ELSE (network_rx_bytes_total - LAG(network_rx_bytes_total) OVER w)\n         / NULLIF(EXTRACT(EPOCH FROM (time - LAG(time) OVER w)), 0)\n  END AS \"RX bytes/s\",\n  CASE\n    WHEN network_tx_bytes_total < LAG(network_tx_bytes_total) OVER w THEN NULL\n    ELSE (network_tx_bytes_total - LAG(network_tx_bytes_total) OVER w)\n         / NULLIF(EXTRACT(EPOCH FROM (time - LAG(time) OVER w)), 0)\n  END AS \"TX bytes/s\"\nFROM observability.host_metrics\nWHERE $__timeFilter(time)\nWINDOW w AS (PARTITION BY node_id ORDER BY time)\nORDER BY time ASC;",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
