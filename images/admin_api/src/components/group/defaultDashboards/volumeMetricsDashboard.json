          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  service                AS \"Service\",\n  node_name              AS \"Node\",\n  volume_name            AS \"Volume\",\n  driver                 AS \"Driver\",\n  used_bytes             AS \"Used\",\n  total_bytes            AS \"Total\",\n  time                   AS \"Last update\"\nFROM (\n  SELECT DISTINCT ON (volume_name)\n    service,\n    node_name,\n    volume_name,\n    driver,\n    used_bytes,\n    total_bytes,\n    time\n  FROM observability.volume_metrics\n  WHERE volume_name != ''\n  ORDER BY volume_name, time DESC\n) latest\nORDER BY service, volume_name;",
