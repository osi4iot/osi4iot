          "rawQuery": true,
          "rawSql": "SELECT\nformat(\n'| %s | %s | replica:%s|%s',\nlevel,\nservice,\nreplica,\nmessage\n) AS line,\ntime,\nlevel,\nservice,\nreplica,\nmessage,\nCOALESCE(metadata::text, '{}') AS metadata\nFROM observability.log_entries\nWHERE $__timeFilter(time)\nAND ('$level' = 'All' OR level = '$level')\nAND service IN (${service:singlequote})\nAND replica IN (${replica:singlequote})\nAND ('$text_search' = '' OR message ILIKE '%$text_search%')\nORDER BY time DESC\nLIMIT 1000;",
