      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PC9F690ACD2F736A4"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH deltas AS (\n  SELECT\n    failed_count - lag(failed_count) OVER (ORDER BY time) AS delta\n  FROM observability.wal_archiver_metrics\n  WHERE time > NOW() - INTERVAL '15 minutes'\n    AND cluster = 'admin'\n)\nSELECT COALESCE(SUM(delta) FILTER (WHERE delta > 0), 0) AS \"New failures\"\nFROM deltas;\n",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
      "title": "patroni_admin — archive failures (15m)",
      "type": "stat"
    },
