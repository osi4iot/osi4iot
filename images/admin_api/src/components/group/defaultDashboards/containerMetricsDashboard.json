      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PC9F690ACD2F736A4"
          },
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  time,\n  service || '.' || replica_slot AS \"Container\",\n  CASE\n    WHEN network_rx_bytes_total < LAG(network_rx_bytes_total) OVER w THEN NULL\n    ELSE (network_rx_bytes_total - LAG(network_rx_bytes_total) OVER w)\n         / NULLIF(EXTRACT(EPOCH FROM (time - LAG(time) OVER w)), 0)\n  END AS \"RX bytes/s\",\n  CASE\n    WHEN network_tx_bytes_total < LAG(network_tx_bytes_total) OVER w THEN NULL\n    ELSE (network_tx_bytes_total - LAG(network_tx_bytes_total) OVER w)\n         / NULLIF(EXTRACT(EPOCH FROM (time - LAG(time) OVER w)), 0)\n  END AS \"TX bytes/s\"\nFROM observability.container_metrics\nWHERE $__timeFilter(time)\n  AND service IN ($service)\n  AND replica_slot IN ($replica)\n  AND node_name = $node\nWINDOW w AS (PARTITION BY container_id ORDER BY time)\nORDER BY time ASC;",
          "refId": "A",
