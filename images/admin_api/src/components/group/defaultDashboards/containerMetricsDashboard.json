      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PC9F690ACD2F736A4"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH ranked AS (\n  SELECT *,\n    ROW_NUMBER() OVER (PARTITION BY service, replica_slot ORDER BY time DESC) AS rn\n  FROM observability.container_metrics\n  WHERE time > NOW() - INTERVAL '2 minutes'\n    AND service IN ($service)\n    AND replica_slot IN ($replica)\n),\nlatest AS (SELECT * FROM ranked WHERE rn = 1),\nprev   AS (SELECT * FROM ranked WHERE rn = 2)\nSELECT\n  l.service                                                AS \"Service\",\n  l.node_name                                             AS \"Node\",\n  l.replica_slot                                          AS \"Replica\",\n  l.state                                                 AS \"State\",\n  l.cpu_usage_percent                                     AS \"CPU %\",\n  l.memory_working_set_bytes                              AS \"Memory used\",\n  l.memory_limit_bytes                                    AS \"Memory total\",\n  l.memory_usage_percent                                  AS \"Memory %\",\n  CASE\n    WHEN l.network_rx_bytes_total < p.network_rx_bytes_total THEN NULL\n    ELSE (l.network_rx_bytes_total - p.network_rx_bytes_total)\n         / NULLIF(EXTRACT(EPOCH FROM (l.time - p.time)), 0)\n  END                                                     AS \"Net received\",\n  CASE\n    WHEN l.network_tx_bytes_total < p.network_tx_bytes_total THEN NULL\n    ELSE (l.network_tx_bytes_total - p.network_tx_bytes_total)\n         / NULLIF(EXTRACT(EPOCH FROM (l.time - p.time)), 0)\n  END                                                     AS \"Net transmitted\",\n  l.time                                                  AS \"Last update\"\nFROM latest l\nLEFT JOIN prev p ON p.service = l.service AND p.replica_slot = l.replica_slot\nORDER BY l.service, l.replica_slot;",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
